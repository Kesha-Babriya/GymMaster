# GymMaster Client Environment Variables
# Copy this file to .env for local development

# Backend API base URL
# Local development: http://localhost:5000
# Production (Render): https://<your-render-service-name>.onrender.com
VITE_API_URL=http://localhost:5000

# Legacy fallback variable (supported for backward compatibility)
# VITE_DEV_API=http://localhost:5000

# (Optional) RapidAPI Key for live ExerciseDB and YouTube workout tutorials
# If left blank or unset, GymMaster automatically activates its built-in offline exercise library
# VITE_RAPID_API_KEY=your_rapidapi_key_here
