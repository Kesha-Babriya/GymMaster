# GymMaster Server Environment Variables
# Copy this file to .env for local development

# Server network port (Defaults to 5000 locally; Render assigns PORT automatically)
PORT=5000

# MongoDB Atlas connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/<databaseName>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/test?retryWrites=true&w=majority

# Secret cryptographic key for signing and verifying JWT authentication tokens
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Production frontend URL(s) for CORS access (e.g. Vercel deployment URL)
# Multiple origins can be comma-separated: https://your-site.vercel.app,http://localhost:5173
CLIENT_URL=https://<your-vercel-app>.vercel.app

# Environment mode (development or production)
NODE_ENV=development
